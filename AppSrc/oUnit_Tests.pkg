// oUnit_Tests.pkg - the root fixture for the unit tests of the RDCFlexTron library (RDCFlexTronDev26.0.sws).
//
// This is the only file to edit when a test file is added: one Use line per subject. One file per package or
// per function under test, named o<Subject>-Tests.pkg.

Use DFUnit\Fixturing\Fixture.pkg

Object oWorkspace_Tests is a cTestFixture
    Set psTestFixtureName to "RDCFlexTron"

    Procedure Setup
    End_Procedure

    Procedure TearDown
    End_Procedure

    // *** Test files below - one Use line per subject: ***
    Use oFTMarkupBuilders-Tests.pkg
    Use oFTAppGlyphs-Tests.pkg
    Use oFTDashIcons-Tests.pkg
    Use oFTThemeIcons-Tests.pkg
    Use oFTCalendar-Tests.pkg

End_Object
