//****************************************************************************
// $Module type: Package
// $Module name: FTMessageBox
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-28
//
// Description : Info_Box, Stop_Box and YesNo_Box in the FT look: FTInfoBox, FTStopBox and FTYesNoBox take
//               the arguments those take and return what they return, and show the message in
//               FTMessageBox.dg - a dialog in the theme, where Windows' own message box stays light.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use Msgbox.pkg              // Message_Box, the MB_ and MBR_ values, and C_$Information / C_$Stop / C_$Question
Use FTMarkupBuilders.pkg    // FTHtmlEscape
Use FTDashIcons.pkg         // CS_GlyphInfo, CS_GlyphStop, CS_GlyphHelp

/* WHY A REPLACEMENT (it follows DFRefactor's FTRefactorMessageBox.pkg, 2026-07-30): Info_Box, Stop_Box and
   YesNo_Box end in the Win32 MessageBox API, and Windows draws that box itself - no colour hook, no dark
   mode - so a message box in the theme has to be a dialog of its own.

   These three are TWINS of the originals (Msgbox.pkg), so a program calls them where it would call those:
     - FTInfoBox and FTStopBox are procedures (Send FTInfoBox ...), FTYesNoBox is a function
       (Get FTYesNoBox ... to iAnswer);
     - the caption is optional, as it is there, and the same captions stand in for a missing one;
     - FTYesNoBox returns MBR_Yes or MBR_No, never a Boolean: callers compare with those;
     - the two characters \n in a message are a new line, as Message_Box makes them.

   UNTIL THE DIALOG EXISTS - a message while the program starts - they show Windows' own box; a light box
   then is better than no message. A second message asked while the dialog shows gets Windows' box too
   (FTMessageBox.dg).

   KNOWN GAP: FTYesNoBox's DfltBtn (which button Enter presses) is taken and not used. Esc declines - the
   safe way round. */

// FTMessageBox.dg's dialog, once it exists; 0 until then.
Global_Variable Handle ghoFTMessageBox
Move 0 to ghoFTMessageBox

// FTMessageBox.dg defines it - later than this package is compiled.
Register_Function FTShowMessage String sGlyph String sTitle String sMessage String sYesLabel ;
                                String sNoLabel Returns Boolean

// A message written for a Win32 box, as the dialog's HTML: escaped - it is prose and paths, never markup -
// with its line breaks kept: the two characters \n that Message_Box makes a new line, and real ones.
Function FTMessageBoxHtml Global String sMessage Returns String
    String sOut sBreak
    Move (Replaces(">", FTHtmlEscape(sMessage), "&gt;")) to sOut
    Move "" to sBreak
    Append sBreak "\" "n"
    Move (Replaces(sBreak, sOut, "<br>")) to sOut
    Move (Replaces((Character(13) + Character(10)), sOut, "<br>")) to sOut
    Move (Replaces(Character(13), sOut, "<br>")) to sOut
    Move (Replaces(Character(10), sOut, "<br>")) to sOut
    Function_Return ('<div class="ftmsg"><p>' + sOut + '</p></div>')
End_Function

// Info_Box's twin: a procedure, 1 or 2 arguments. The caption stands in only when there is no second one.
Procedure FTInfoBox Global String sMessage String sTitle
    String sCaption
    Boolean bVoid
    Integer iVoid
    If (Num_Arguments = 1) ;
        Move C_$Information to sCaption
    Else ;
        Move sTitle to sCaption
    If (ghoFTMessageBox = 0) Begin
        Move (Message_Box(sMessage, sCaption, MB_OK, MB_ICONINFORMATION)) to iVoid
        Procedure_Return
    End
    Get FTShowMessage of ghoFTMessageBox CS_GlyphInfo sCaption sMessage "OK" "" to bVoid
End_Procedure

// Stop_Box's twin: the same shape, a stop mark beside the caption. An empty caption is a missing one.
Procedure FTStopBox Global String sMessage String sTitle
    String sCaption
    Boolean bVoid
    Integer iVoid
    If ((Num_Arguments = 1) or (sTitle = "")) ;
        Move C_$Stop to sCaption
    Else ;
        Move sTitle to sCaption
    If (ghoFTMessageBox = 0) Begin
        Move (Message_Box(sMessage, sCaption, MB_OK, MB_ICONHAND)) to iVoid
        Procedure_Return
    End
    Get FTShowMessage of ghoFTMessageBox CS_GlyphStop sCaption sMessage "OK" "" to bVoid
End_Procedure

// YesNo_Box's twin: a FUNCTION, 1 to 3 arguments, returning MBR_Yes or MBR_No. Windows' own box, the fallback,
// honours DfltBtn as YesNo_Box does.
Function FTYesNoBox Global String sMessage String sTitle Integer DfltBtn Returns Integer
    String sCaption
    Integer iDflt
    Boolean bYes
    If ((Num_Arguments = 1) or (sTitle = "")) ;
        Move C_$Question to sCaption
    Else ;
        Move sTitle to sCaption
    If (ghoFTMessageBox = 0) Begin
        If ((Num_Arguments < 3) or (DfltBtn = 0) or (DfltBtn = MB_DEFBUTTON1)) ;
            Move MB_DEFBUTTON1 to iDflt
        Else ;
            Move MB_DEFBUTTON2 to iDflt
        Function_Return (Message_Box(sMessage, sCaption, MB_YESNO, (MB_ICONQUESTION ior iDflt)))
    End
    Get FTShowMessage of ghoFTMessageBox CS_GlyphHelp sCaption sMessage "Yes" "No" to bYes
    If (bYes) ;
        Function_Return MBR_Yes
    Function_Return MBR_No
End_Function
