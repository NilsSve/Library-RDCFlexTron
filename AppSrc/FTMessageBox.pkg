//****************************************************************************
// $Module type: Package
// $Module name: FTMessageBox
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-28
//
// Description : Info_Box, Stop_Box and YesNo_Box in the FT look: FTInfoBox, FTStopBox and FTYesNoBox take
//               the arguments those take and return what they return, and show the message in
//               FTMessageBox.dg - a dialog in the theme, where Windows' own message box stays light.
//               FTHtmlMessage shows a message written in HTML, with the caller's own button captions.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use Msgbox.pkg              // Message_Box, the MB_ and MBR_ values, and C_$Information / C_$Stop / C_$Question
Use LanguageText.pkg        // C_$DeleteThisRecord, C_$DeleteThisLine, C_$Confirm
Use FTMarkupBuilders.pkg    // FTHtmlEscape, DivOpen, ParaHtml - and, from FTConstants.h.pkg, CS_Br and CS_DivEnd
Use FTDashIcons.pkg         // CS_GlyphInfo, CS_GlyphStop, CS_GlyphHelp

/* WHY A REPLACEMENT (it follows DFRefactor's FTRefactorMessageBox.pkg, 2026-07-30): Info_Box, Stop_Box and
   YesNo_Box end in the Win32 MessageBox API, and Windows draws that box itself - no colour hook, no dark
   mode - so a message box in the theme has to be a dialog of its own.

   These three are TWINS of the originals (Msgbox.pkg), so a program calls them where it would call those:
     - FTInfoBox and FTStopBox are procedures (Send FTInfoBox ...), FTYesNoBox is a function
       (Get FTYesNoBox ... to iAnswer);
     - the caption is optional, as it is there, and the same captions stand in for a missing one;
     - FTYesNoBox returns MBR_Yes or MBR_No, never a Boolean: callers compare with those;
     - the two characters \n in a message are a new line, as Message_Box makes them.

   FTMessageBox.dg CAN BE USED ANYWHERE, above the application object too: built before the theme is read,
   the dialog takes it as soon as it is (FTThemeColors.pkg). Windows' own box answers when the dialog
   cannot: in a program that does not Use FTMessageBox.dg, and before the application object exists. A
   light box then is better than no message. A second message asked while the dialog shows gets Windows'
   box too (FTMessageBox.dg).

   KNOWN GAP: FTYesNoBox's DfltBtn (which button Enter presses) is taken and not used. Esc declines - the
   safe way round. */

// FTMessageBox.dg's dialog, once it exists; 0 until then.
Global_Variable Handle ghoFTMessageBox
Move 0 to ghoFTMessageBox

// FTMessageBox.dg defines them - later than this package is compiled.
Register_Function FTShowMessage String sGlyph String sTitle String sMessage String sYesLabel ;
                                String sNoLabel Returns Boolean
Register_Function FTShowMessageHtml String sGlyph String sTitle String sBodyHtml String sYesLabel ;
                                    String sNoLabel Returns Boolean

// The dialog - or 0 when Windows' own box answers: the program does not Use FTMessageBox.dg, or its
// application object does not exist yet.
Function FTMessageBoxPanel Global Returns Handle
    If (ghoApplication = 0) ;
        Function_Return 0
    Function_Return ghoFTMessageBox
End_Function

// A message written for a Win32 box, as the dialog's HTML: escaped - it is prose and paths, never markup -
// with its line breaks kept: the two characters \n that Message_Box makes a new line, and real ones.
Function FTMessageBoxHtml Global String sMessage Returns String
    String sOut sBreak
    Move (Replaces(">", FTHtmlEscape(sMessage), "&gt;")) to sOut
    Move "" to sBreak
    Append sBreak "\" "n"
    Move (Replaces(sBreak, sOut, CS_Br)) to sOut
    Move (Replaces((Character(13) + Character(10)), sOut, CS_Br)) to sOut
    Move (Replaces(Character(13), sOut, CS_Br)) to sOut
    Move (Replaces(Character(10), sOut, CS_Br)) to sOut
    Function_Return ((DivOpen("ftmsg")) + (ParaHtml("", sOut)) + CS_DivEnd)
End_Function

/* The other way: a message's HTML as plain text - for Windows' own box, when the dialog cannot show it, and for
   the length that picks the dialog's size. A paragraph, a line break and a code sample end a line, a list item
   too; the other tags go; then the entities are decoded - after the tags are gone, so an escaped "<" in the text
   is not taken for one. */
Function FTMessageBoxText Global String sHtml Returns String
    String sIn sOut sCh
    Integer i iLen
    Boolean bInTag
    Move (Replaces(CS_ParaEnd, sHtml, Character(10))) to sIn
    Move (Replaces(CS_Br, sIn, Character(10))) to sIn
    Move (Replaces("<pre>", sIn, Character(10))) to sIn
    Move (Replaces("</pre>", sIn, Character(10))) to sIn
    Move (Replaces("</li>", sIn, Character(10))) to sIn
    Move "" to sOut
    Move False to bInTag
    Move (Length(sIn)) to iLen
    For i from 1 to iLen
        Move (Mid(sIn, 1, i)) to sCh
        If (sCh = "<") ;
            Move True to bInTag
        Else If (sCh = ">") ;
            Move False to bInTag
        Else If (bInTag = False) ;
            Move (sOut + sCh) to sOut
    Loop
    Move (Replaces(CS_EmDash, sOut, "-")) to sOut
    Move (Replaces(CS_Ellipsis, sOut, "...")) to sOut
    Move (Replaces(CS_MidDot, sOut, "-")) to sOut
    Move (Replaces(CS_Nbsp, sOut, " ")) to sOut
    Move (Replaces("&lt;", sOut, "<")) to sOut
    Move (Replaces("&gt;", sOut, ">")) to sOut
    Move (Replaces("&quot;", sOut, '"')) to sOut
    Move (Replaces("&#39;", sOut, "'")) to sOut
    Move (Replaces("&amp;", sOut, "&")) to sOut         // last, or "&amp;lt;" would become "<"
    Function_Return (Trim(sOut))
End_Function

// Info_Box's twin: a procedure, 1 or 2 arguments. The caption stands in only when there is no second one.
Procedure FTInfoBox Global String sMessage String sTitle
    String sCaption
    Boolean bVoid
    Integer iVoid
    Handle hoPanel
    If (Num_Arguments = 1) ;
        Move C_$Information to sCaption
    Else ;
        Move sTitle to sCaption
    Move (FTMessageBoxPanel()) to hoPanel
    If (hoPanel = 0) Begin
        Move (Message_Box(sMessage, sCaption, MB_OK, MB_ICONINFORMATION)) to iVoid
        Procedure_Return
    End
    Get FTShowMessage of hoPanel CS_GlyphInfo sCaption sMessage "OK" "" to bVoid
End_Procedure

// Stop_Box's twin: the same shape, a stop mark beside the caption. An empty caption is a missing one.
Procedure FTStopBox Global String sMessage String sTitle
    String sCaption
    Boolean bVoid
    Integer iVoid
    Handle hoPanel
    If ((Num_Arguments = 1) or (sTitle = "")) ;
        Move C_$Stop to sCaption
    Else ;
        Move sTitle to sCaption
    Move (FTMessageBoxPanel()) to hoPanel
    If (hoPanel = 0) Begin
        Move (Message_Box(sMessage, sCaption, MB_OK, MB_ICONHAND)) to iVoid
        Procedure_Return
    End
    Get FTShowMessage of hoPanel CS_GlyphStop sCaption sMessage "OK" "" to bVoid
End_Procedure

// YesNo_Box's twin: a FUNCTION, 1 to 3 arguments, returning MBR_Yes or MBR_No. Windows' own box, the fallback,
// honours DfltBtn as YesNo_Box does.
Function FTYesNoBox Global String sMessage String sTitle Integer DfltBtn Returns Integer
    String sCaption
    Integer iDflt
    Boolean bYes
    Handle hoPanel
    If ((Num_Arguments = 1) or (sTitle = "")) ;
        Move C_$Question to sCaption
    Else ;
        Move sTitle to sCaption
    Move (FTMessageBoxPanel()) to hoPanel
    If (hoPanel = 0) Begin
        If ((Num_Arguments < 3) or (DfltBtn = 0) or (DfltBtn = MB_DEFBUTTON1)) ;
            Move MB_DEFBUTTON1 to iDflt
        Else ;
            Move MB_DEFBUTTON2 to iDflt
        Function_Return (Message_Box(sMessage, sCaption, MB_YESNO, (MB_ICONQUESTION ior iDflt)))
    End
    Get FTShowMessage of hoPanel CS_GlyphHelp sCaption sMessage "Yes" "No" to bYes
    If (bYes) ;
        Function_Return MBR_Yes
    Function_Return MBR_No
End_Function

/* DataFlex's Delete_Confirmation and Line_Delete_Confirmation (Dfconfrm.pkg) in the FT look - the question a
   grid, a field or a data-aware FT host asks before it deletes, named in its Verify_Delete_Msg:

       Set Verify_Delete_Msg to (RefFunc(FTDelete_Confirmation))           // a field, a data-aware host
       Set Verify_Delete_Msg to (RefFunc(FTLine_Delete_Confirmation))      // a grid's row

   As Dfconfrm.pkg's, they return non-zero - do not delete - unless the user answers Yes. FTYesNoBox shows the
   dialog of FTMessageBox.dg, which the program Uses. */
Function FTDelete_Confirmation for cUIObject Returns Integer
    Integer iAnswer
    Get FTYesNoBox C_$DeleteThisRecord C_$Confirm to iAnswer
    Function_Return (iAnswer <> MBR_Yes)
End_Function

Function FTLine_Delete_Confirmation for cUIObject Returns Integer
    Integer iAnswer
    Get FTYesNoBox C_$DeleteThisLine C_$Confirm to iAnswer
    Function_Return (iAnswer <> MBR_Yes)
End_Function

/* A MESSAGE WRITTEN IN HTML, with the caller's own button captions - what the three above cannot say: a body in
   paragraphs, bold and code samples, and a verb on each button ("Rename now" / "Not now") rather than Yes and No.
   sBodyHtml is HTML the caller has built: text in it is already escaped. sNoLabel "" gives one button; sYesLabel ""
   is OK. Returns True for the first button, False for the second or Esc - a Boolean, where FTYesNoBox returns
   MBR_Yes. Beside the caption: a question mark when there are two buttons, an i when there is one - or the glyph
   named in sGlyph (CS_GlyphStop, say). Windows' own box answers when the dialog cannot, with the text of the HTML.

       Get FTHtmlMessage "Rename the view?" sBodyHtml "Rename now" "Not now" to bRename                      */
Function FTHtmlMessage Global String sTitle String sBodyHtml String sYesLabel String sNoLabel String sGlyph Returns Boolean
    String sCaption sYes sKind
    Integer iRet
    Boolean bYes
    Handle hoPanel
    Move sTitle to sCaption
    Move sYesLabel to sYes
    If (sYes = "") ;
        Move "OK" to sYes
    If (sNoLabel <> "") ;
        Move CS_GlyphHelp to sKind
    Else ;
        Move CS_GlyphInfo to sKind
    If ((Num_Arguments >= 5) and (sGlyph <> "")) ;
        Move sGlyph to sKind
    If (Trim(sCaption) = "") Begin
        If (sNoLabel <> "") ;
            Move C_$Question to sCaption
        Else ;
            Move C_$Information to sCaption
    End
    Move (FTMessageBoxPanel()) to hoPanel
    If (hoPanel = 0) Begin
        If (sNoLabel <> "") Begin
            Move (Message_Box((FTMessageBoxText(sBodyHtml)), sCaption, MB_YESNO, MB_ICONQUESTION)) to iRet
            Function_Return (iRet = MBR_Yes)
        End
        Move (Message_Box((FTMessageBoxText(sBodyHtml)), sCaption, MB_OK, MB_ICONINFORMATION)) to iRet
        Function_Return True
    End
    Get FTShowMessageHtml of hoPanel sKind sCaption sBodyHtml sYes sNoLabel to bYes
    Function_Return bYes
End_Function
