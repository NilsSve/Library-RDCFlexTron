//****************************************************************************
// $Module type: Class Package
// $Module name: cFTWebHtmlBox
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-02
//
// Description : FlexTron (FT) subclass of cWebHtmlBox: theme-aware behaviour for the FT
//               build, a click whose work runs after the web event has returned (OnHtmlClick),
//               and an UpdateHtml that keeps what it pushes, for the page's next mount. The
//               HtmlBox renders in the FRAMEWORK DOM - style accordingly.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cWebHtmlBox.pkg
Use seq_chnl.pkg               // Seq_New_Channel - the design-time dump below
Use cFTClickRelay.pkg          // the click relay - OnHtmlClick runs after the web event has returned
Use FTPageIsUp.pkg             // FTHostPageIsUp - can the host's page take a live push now?

// Drop-in for cWebHtmlBox that is marked NOT data-aware. The "Clear" toolbar button does
// `Broadcast Recursive Send Request_Clear of (Client_Id(ghoCommandBars))` (DFRefactorFT.src), which reaches
// EVERY web control in the client area. A bare cWebHtmlBox answers Request_Clear by delegating the DEO request
// to a server DEO it does not have -> GET_SERVERDEO -> Error 98 "Invalid message" (a whole series of them, on
// oWebShowAll_htm et al., when the Test Compile / output docks are open - Nils, LegacyApp 2026-07-02). DEO_Object
// False marks it non-data-aware so DEO-request broadcasts skip it (also covers Request_Save / Clear_All); the
// empty Request_Clear mirrors the sibling FT web controls (cFTWebButton et al.) as a guaranteed guard for the
// exact broadcast (a read-only HTML box has nothing to clear anyway). Otherwise identical to cWebHtmlBox.
// MOCKUPS FOR THE DESIGNER (0.9.7). A box whose content is built when the program runs shows nothing in the Studio's
// Designer, which runs no code: it draws only a LITERAL psHtml. One short literal draws the content's shape instead -
// ftcontrols.css does the drawing: Set psHtml to '<div class="ftph-grid"><b>Name</b><b>Version</b></div>' is a grid
// with those two columns. There are a list, a tree, a log, a chart and cards too; the README's "Mockups for the
// Studio's Designer" lists them. Set the real content in End_Construct_Object, or when the dialog opens.
// Inherited from cWebHtmlBox; stated so the Designer models this class without the pooled package.
{ DesignerJSClass=df.WebHtmlBox }
// Clicks reach OnClick by default (Construct_Object below); the Studio's Properties panel shows the same default.
{ OverrideProperty=pbServerOnClick InitialValue=True }
/* THE DESIGN-TIME DUMP - a regeneration aid for the Designer placeholders, off by default.
   Every FlexTron dialog seeds its HTML boxes with an EXPRESSION at construct, which the Studio's
   Windows Designer cannot evaluate, so each box also carries a LITERAL copy of that markup for
   the Designer (2026-09-21). Those literals must be regenerated when a builder changes. A
   throwaway copy of the program sets gbFTDesignDump before any object constructs; every box is
   then remembered as it is built (gahoFTDesignBoxes), and once every object is built the program
   sends FTDesignDumpAll, which appends '<full object name>|<psHtml>' to gsFTDesignDumpFile for
   each - the exact string the runtime seeds, in the no-workspace state. The real program never
   sets the flag, so this costs one Boolean test per box.

   WRITTEN AT THE END, NOT AS EACH BOX FINISHES (2026-09-29). A box sets its runtime markup in its
   OWN End_Construct_Object, after "Forward Send End_Construct_Object" - so a dump written in this
   class's End_Construct_Object came too early, and held the design-time literal instead. */
Global_Variable Boolean gbFTDesignDump
Global_Variable String  gsFTDesignDumpFile
Global_Variable Handle[] gahoFTDesignBoxes
Move False to gbFTDesignDump
Move "" to gsFTDesignDumpFile

Class cFTWebHtmlBox is a cWebHtmlBox

    /* THE COLUMN DEFAULT, not a per-object decision. 47 of the 52 boxes in this app set
       piColumnIndex to 0 and the other five set 4, 8, 10 or 12 - so the value that was
       repeated 47 times is the default, and the five that differ override it exactly as
       they did when every site spelled it out. Behaviour-neutral: nothing loses a setting,
       47 lines stop restating one.

       CLICKS REACH OnClick BY DEFAULT (0.9.9), for the same reason: 22 of DFRefactor's 30 boxes
       set pbServerOnClick to True. It costs nothing on a box with nothing to click - the web
       engine sends a click to the server only when the clicked element, or one around it,
       carries data-ServerOnClick (WebHtmlBox.js). A box that must ignore such an element still
       sets it False.
    */
    Procedure Construct_Object
        Forward Send Construct_Object

        Set piColumnIndex to 0
        Set pbServerOnClick to True
        // The design-time dump: remembered now, written by FTDesignDumpAll once every object is built.
        If (gbFTDesignDump) ;
            Move Self to gahoFTDesignBoxes[-1]
    End_Procedure

    Function DEO_Object Returns Boolean
        Function_Return False
    End_Function

    Procedure Request_Clear
    End_Procedure

    /* THE CLICK'S WORK AFTER THE CLICK HAS ENDED (0.9.14). The framework's OnClick runs inside the WebView2
       event, and a modal panel, a Close_Panel, a view activation or a file dialog from there faults (4410).
       So OnClick hands the click to the relay (cFTClickRelay.pkg), and one tick later - after the event has
       returned - OnHtmlClick runs with the same sId and sParam. An object that overrides OnClick itself runs
       its code inside the click, as before: Forward it, or OnHtmlClick never runs. What must happen inside the
       click - a grid read, which faults after it - stays in the override, before the Forward; the rest goes
       in OnHtmlClick. Every FT dialog of DFRefactor's had a timer of its own for this until then. */
    Procedure OnClick String sId String sParam
        Forward Send OnClick sId sParam
        Send RelayHtmlClick of (FTClickRelay()) Self sId sParam
    End_Procedure

    // The click's work, after the web event has returned: sId is the element's data-ServerOnClick value, sParam
    // its data-OnClickParam.
    { MethodType=Event }
    Procedure OnHtmlClick String sId String sParam
    End_Procedure

    /* THE PUSH KEEPS WHAT IT PUSHES (0.9.16), and is gated on the host page actually being ALIVE.

       A page is served two ways: the stored psHtml when it mounts - at its first show, and after a
       navigation - and UpdateHtml, a ClientAction ("updateHtml"), while it is up. The framework's
       UpdateHtml only pushes, so a box pushed but never stored came back with its old markup when its
       dialog opened again, and every push site wrote the pair - Set psHtml, then Send UpdateHtml. This
       one stores first, always: the property is what the next mount serves, the push is what the live
       page shows, and one call is the whole of it.

       THE GATE: delivered before the page's df.LocalApp has built its controls, the ClientAction breaks
       the page, and the whole host renders the framework's "Unhandled Program Error on the Client"
       banner (SelectFunctionsFT's Run-button bar, root-caused 2026-07-19: that view mounts BEHIND the
       Folders view and WebView2 THROTTLES hidden windows, so the page can still be initializing long
       after IsComObjectCreated turns True; a flaky cold-start sighting on 2026-07-16 was the same race).
       FTHostPageIsUp (FTPageIsUp.pkg) is the readiness truth, for this push and every other in the
       library: the owning host is active, and its page has called home - the framework's pbInitWebApp
       turns False at a page's FIRST server call (FinishWebObjectInitialize), and cFTThemeHost_mixin
       sets it True again when the host's control is created and when a navigation starts. Until 0.9.23
       the flag alone was asked, and it kept saying "ready" for a dialog that was closed. Until the
       page is up the stored property is all there is, and it is exactly what the mount serves, so
       nothing is lost. ONE canonical home for the gate - the push sites need no per-site guards.
       AppendHtml/UpdateHtmlArray share the ClientAction risk but have no callers - gate them here too
       if they ever gain one. */
    Procedure UpdateHtml String sHtml
        Handle  hoHost
        Set psHtml to sHtml
        Get Owner to hoHost
        If (not(FTHostPageIsUp(hoHost))) ;
            Procedure_Return
        Forward Send UpdateHtml sHtml
    End_Procedure

    /* THE PUSH SHOWN AT ONCE. UpdateHtml queues the new HTML as a client action, and the host's idle tick sends it a
       moment later - fine, unless the program is about to be busy: a pump, a modal, a compile about to start, where the
       page would show the old content until the busy work ends. PushHtml is UpdateHtml and then the host's own flush
       (CheckUpdateWebUI), when the page is up; before that, nothing was queued and there is nothing to flush. A flush
       is a round trip, so several boxes in a row take UpdateHtml each and PushHtml for the last. */
    Procedure PushHtml String sHtml
        Handle  hoHost

        Send UpdateHtml sHtml
        Get Owner to hoHost
        If (FTHostPageIsUp(hoHost)) ;
            Send CheckUpdateWebUI of hoHost
    End_Procedure

End_Class

// The design-time dump (see gbFTDesignDump above): '<full object name>|<psHtml>' for every box, each with the markup
// it ended its construction with. Sent by the dump program once every object is built.
Procedure FTDesignDumpAll Global
    String sHtml
    Integer i iCh
    If ((gbFTDesignDump = False) or (gsFTDesignDumpFile = "")) ;
        Procedure_Return
    Move (Seq_New_Channel()) to iCh
    If (iCh < 0) ;
        Procedure_Return
    Append_Output channel iCh gsFTDesignDumpFile
    For i from 0 to (SizeOfArray(gahoFTDesignBoxes) - 1)
        Get psHtml of gahoFTDesignBoxes[i] to sHtml
        If (sHtml <> "") Begin
            Move (Replaces(Character(13), sHtml, "")) to sHtml
            Move (Replaces(Character(10), sHtml, "")) to sHtml
            Writeln channel iCh (Name(gahoFTDesignBoxes[i]) + "|" + sHtml)
        End
    Loop
    Close_Output channel iCh
    Send Seq_Release_Channel iCh
End_Procedure
