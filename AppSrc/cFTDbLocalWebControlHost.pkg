//****************************************************************************
// $Module type: Class Package
// $Module name: cFTDbLocalWebControlHost
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-13
//
// Description : FT variant of the data-aware FlexTron web host - the cDbLocalWebControlHost counterpart of
//               cFTLocalWebControlHost. Same theme behaviour, same mixin; see cFTThemeHost_mixin.pkg.
//
//               It cannot simply extend cFTLocalWebControlHost: the framework's own chain is
//               cDbLocalWebControlHost -> cBaseDbLocalWebControlHost -> cLocalWebControlHost, so deriving from our
//               FT class would drop everything the Db layer adds. Hence two classes sharing one include.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cDbLocalWebControlHost.pkg
Use FTConstants.h.pkg           // CI_FTTheme* + giFTThemeMode
Use FTThemeColors.pkg           // FTWebBg - the WebView2 back colour
Use cFTThemeHost_mixin.pkg      // the shared theme members (was FTThemeHost.inc)
Use cFTDeferTimer.pkg           // the focus field's one tick after the page is up
Use FTPageIsUp.pkg              // FTHostPageIsUp
Use cWebList.pkg                // a list's Find goes through one of its columns (FTListFindColumn)

Register_Procedure FTFocusTheFocusField

// The host's focus-field timer (cFTDbLocalWebControlHost, below), for a clear: it waits while the host is up and
// its page is not, then gives the focus field the focus. Its parent is the host.
{ Visibility=Private }
Class cFTFocusFieldTimer is a cFTDeferTimer
    Procedure Construct_Object
        Forward Send Construct_Object
        Set piTimeout to 100
    End_Procedure

    Function DeferHold Returns Boolean
        Handle hoHost
        Move (Parent(Self)) to hoHost
        Function_Return (Active_State(hoHost) and not(FTHostPageIsUp(hoHost)))
    End_Function

    Procedure OnDeferredAction Integer iAction String sParam
        Send FTFocusTheFocusField of (Parent(Self))
    End_Procedure
End_Class

/* Both tags are inherited from cLocalWebControlHost (Studio help: "the DesignerClass meta-tag is
   inherited"), and are stated here so the Windows Designer's view of this class does not depend on
   the pooled package having been parsed first. */
// The host's own class, for the Studio: its Designer runs none of this code, so the third tag tells it that an FT
// host's element carries FtHost - what ftcontrols.css keys the framework controls' FT look on (ApplyFTHostClass
// in cFTThemeHost_mixin.pkg).
{ DesignerClass=cDTWebControlHost }
{ DesignerJSClass=df.WebApp }
{ OverrideProperty=psCSSClass InitialValue="FtHost" }
Class cFTDbLocalWebControlHost is a cDbLocalWebControlHost

    Import_Class_Protocol cFTThemeHost_mixin

    // THE FOCUS FIELD (0.9.34, 2026-11-19). A native view has Auto_Top_View_State: its first field takes the focus
    // when the view is shown and after a clear, and the toolbar's Find, Prompt, Clear ... act on it. The native
    // Auto_Top states stop at the host - to them it is one control - so a host does that for the fields on its
    // page here:
    //
    // - The toolbar acts on the field that has the focus (0.9.39, Nils 2026-11-19: "the logic needs to ask the
    //   focused object for its server" - an order view's Order number, Customer, Sales person or Payment Terms
    //   field, or its lines' list, each finds in its own table). The page reports each move of the focus
    //   (FTFocusSync), so FocusObject is the control that has it; DEOControlFocusObject below makes it a Find
    //   target. Only when no data field has had the focus yet does it fall back to the focus field.
    // - The focus field takes the focus when the page has loaded - the host navigates, so the page loads, every
    //   time the host is shown (OnLoad) - and after Request_Clear and Request_Clear_All (pbFTAutoTopFocus).
    //
    // The focus field is phoFTFocusField, or - when that is 0 - the host's first enabled field bound to a column
    // of its Server's table, in object order (FTFocusField).
    Procedure Construct_Object
        Handle hoTimer
        Forward Send Construct_Object
        // The field the toolbar acts on, and that takes the focus; 0 - the first enabled field of the Server's table.
        Property Handle phoFTFocusField 0
        // False - the focus field does not take the focus when the host is shown or cleared; the toolbar still
        // acts on it.
        Property Boolean pbFTAutoTopFocus True
        Property Handle phoFTFocusTimer 0
        // The last data field - or list column - the toolbar acted on: kept for a focus that is not one (a button).
        Property Handle phoFTLastFindTarget 0
        Get Create (RefClass(cFTFocusFieldTimer)) to hoTimer
        Set phoFTFocusTimer to hoTimer
    End_Procedure

    // The focus field (above): phoFTFocusField, else the first enabled field of this host bound to a column of its
    // Server's table - the Server's DEOs are listed in the order they were made, which is the object order. 0 when
    // there is none.
    Function FTFocusField Returns Handle
        Handle hoField hoServer hoDEO
        Integer i iCount
        Boolean bControl
        Get phoFTFocusField to hoField
        If (hoField <> 0) Begin
            Function_Return hoField
        End
        Get Server to hoServer
        If (hoServer = 0) Begin
            Function_Return 0
        End
        Get Data_Set_User_Interface_Count of hoServer to iCount
        For i from 0 to (iCount - 1)
            Get Data_Set_User_Interface of hoServer i to hoDEO
            If (hoDEO <> 0) Begin
                If (IsObjectOfClass(hoDEO, RefClass(cWebObject))) Begin
                    If (Host(hoDEO) = Self) Begin
                        Get DEO_Control_Object of hoDEO to bControl
                        If (bControl and (Data_File(hoDEO) > 0) and pbEnabled(hoDEO) and pbRender(hoDEO)) Begin
                            Function_Return hoDEO
                        End
                    End
                End
            End
        Loop
        Function_Return 0
    End_Function

    // A data-aware list's column a Find goes through: the column it is sorted on (piSortColumn), else the first
    // column bound to its ordering index (piOrdering), else the first column with an index. The column sends the
    // Find to the list's own server (cWebColumn_mixin's Request_Find), as the framework's F7 and F8 in a list
    // do. 0 for a list that is not data-aware, or has no column with an index.
    Function FTListFindColumn Handle hoList Returns Handle
        Handle hoColumn hoServer hoFirst
        Integer iSort iCount i iFile iField iIndex iOrdering
        If (not(pbDataAware(hoList))) Begin
            Function_Return 0
        End
        Get piSortColumn of hoList to iSort
        Get ColumnCount of hoList to iCount
        If ((iSort >= 0) and (iSort < iCount)) Begin
            Get GetColumnObject of hoList iSort to hoColumn
            If ((hoColumn <> 0) and (Data_File(hoColumn) > 0)) Begin
                Function_Return hoColumn
            End
        End
        Get Server of hoList to hoServer
        If (hoServer = 0) Begin
            Function_Return 0
        End
        Get piOrdering of hoList to iOrdering
        Move 0 to hoFirst
        For i from 0 to (iCount - 1)
            Get GetColumnObject of hoList i to hoColumn
            If (hoColumn <> 0) Begin
                Get Data_File of hoColumn to iFile
                Get Data_Field of hoColumn to iField
                If (iFile > 0) Begin
                    Get File_Field_Index of hoServer iFile iField to iIndex
                    If ((iIndex > 0) and (iIndex = iOrdering)) Begin
                        Function_Return hoColumn
                    End
                    If ((iIndex > 0) and (hoFirst = 0)) Begin
                        Move hoColumn to hoFirst
                    End
                End
            End
        Loop
        Function_Return hoFirst
    End_Function

    // The control the toolbar's Find, Prompt, Clear ... act on. The page's focused control (FocusObject, kept
    // current by FTFocusSync) when it is a data field: its own Request_Find goes to its own server, on its own
    // table and column. A data-aware list: its find column (FTListFindColumn), which finds through the list's
    // server. Anything else - a button, an HTML box, no focus yet: the last field or column it acted on, else the
    // focus field (FTFocusField). 0 when there is none of those.
    Function DEOControlFocusObject Returns Handle
        Handle hoFocus hoTarget
        Boolean bDEO bControl
        Get FocusObject to hoFocus
        If ((hoFocus > 0) and (hoFocus <> Self)) Begin
            If (IsObjectOfClass(hoFocus, RefClass(cWebList))) Begin
                Get FTListFindColumn hoFocus to hoTarget
                If (hoTarget <> 0) Begin
                    Set phoFTLastFindTarget to hoTarget
                    Function_Return hoTarget
                End
            End
            Else Begin
                Get DEO_Object of hoFocus to bDEO
                If (bDEO) Begin
                    Get DEO_Control_Object of hoFocus to bControl
                    If (bControl) Begin
                        Set phoFTLastFindTarget to hoFocus
                        Function_Return hoFocus
                    End
                End
            End
        End
        Get phoFTLastFindTarget to hoTarget
        If (hoTarget <> 0) Begin
            Function_Return hoTarget
        End
        Get FTFocusField to hoTarget
        Function_Return hoTarget
    End_Function

    // The focus field the focus: the web focus (Focus), and - when the host has the Windows focus - the keyboard
    // focus to the browser too, or the field has the page's focus and no blinking caret. The browser gets the
    // keyboard focus when the host gets the Windows focus (cWebView2Browser's OnSetFocus sends ComMoveFocus), and a
    // host gets that as its view opens, before its browser is made (Nils 2026-11-19: no caret until a toolbar Find
    // or Clear All). Not by Activate: that is a Windows control's message, and a web field activated so - from a
    // view's End_Construct_Object - left the runtime's focus chain in a state where the next modal dialog hung the
    // program, with no error.
    Procedure FTGiveTheFocusFieldTheFocus
        Handle hoField
        Boolean bCreated
        If (not(pbFTAutoTopFocus(Self))) Begin
            Procedure_Return
        End
        Get FTFocusField to hoField
        If (hoField = 0) Begin
            Procedure_Return
        End
        If (Focus(Desktop) = Self) Begin
            Get IsComObjectCreated to bCreated
            If (bCreated) Begin
                Send ComMoveFocus OLECOREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC
            End
        End
        Send Focus of hoField
    End_Procedure

    // The same, on the focus timer's tick after a clear, when the page is up.
    Procedure FTFocusTheFocusField
        If (FTHostPageIsUp(Self)) Begin
            Send FTGiveTheFocusFieldTheFocus
        End
    End_Procedure

    // The page has loaded (LoadWebApp): the focus field takes the focus. A client action sent here runs once the
    // page is drawn (the framework's OnLoad). Given earlier - when the browser said the page was there - the
    // focus was lost while the page built its controls (0.9.34: no caret, no focused field, seen in screenshots).
    Procedure OnLoad
        Forward Send OnLoad
        Send FTGiveTheFocusFieldTheFocus
    End_Procedure

    Procedure Request_Clear
        Forward Send Request_Clear
        Send Arm of (phoFTFocusTimer(Self))
    End_Procedure

    Procedure Request_Clear_All
        Forward Send Request_Clear_All
        Send Arm of (phoFTFocusTimer(Self))
    End_Procedure

    Procedure End_Construct_Object
        // Forward first: the base sends End_Construct_cWebHostAPI_mixin, which is what brings
        // peThemePreference into existence on this object.
        Forward Send End_Construct_Object
        Send ApplyFTHostClass       // FtHost on the host's element - after the object's body, which may set classes
        Send ApplyFTTheme
        WebPublishProcedure FTFocusSync     // the page reports each move of the focus (cFTThemeHost_mixin)
    End_Procedure

End_Class
