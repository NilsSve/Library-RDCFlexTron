//****************************************************************************
// $Module type: Class Package
// $Module name: cFTWebButton
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-17
//
// Description : FlexTron (FT) subclass of cWebButton: the FT look, a glyph and the caption's font as
//               properties, a main-action variant - the glyph, the variant, classes of your own, the
//               caption, the enabled and shown states and the tooltip changeable while the program
//               runs - and a click whose work runs after the web event has returned. FT twin files are
//               the privacy boundary between the classic and FT builds - never merge them.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cWebButton.pkg
Use cFTClickRelay.pkg            // the click relay - OnButtonClick runs after the web event has returned
Use FTDashIcons.pkg              // DashIcon and the CS_Glyph* names
Use FTMarkupBuilders.pkg         // ImgHtml
Use FTPageIsUp.pkg               // FTHostPageIsUp - can the host's page take a live push now?

/* A REAL WEB BUTTON, NOT MARKUP (Nils 2026-09-26: "Easier to set properties for a button object;
   like font and glyph", and "easier to render the button object in the Studio designer").

   The FT dialogs draw their buttons as HTML inside one cFTWebHtmlBox. The Studio's Windows Designer
   shows such a box only as its literal placeholder - one picture, with nothing in it to select. A web
   control on a FlexTron host is an object of its own: the Designer draws it where it sits, and its
   properties are in the Properties panel.

   The properties were first built as a subclass, cFTButton, and moved into this class the same day
   (Nils: "merge it and keep cFTWebButton"). This class added nothing of its own before, and two names
   for one button is a question every dialog would have had to answer.

   THE CLIENT HALF is rdcft.FTWebButton in AppHtml/RDCFlexTron/ftcontrols.js, the look is
   ftcontrols.css, and the glyphs are ftglyphs.css; every FT host page loads all three
   (cFTThemeHost_mixin, OnDefineScriptIncludes). A DashIcon glyph is a CLASS ("ftg-exit"), which the
   sheet draws in front of the caption. An image file cannot be a class: the framework's df.WebButton
   writes its caption as escaped text, so that glyph travels in a property of its own, psGlyphHtml,
   and the client class puts it in front of the caption.

   IN THE DESIGNER the framework's df.WebButton draws the button - the Designer loads only the
   framework's own scripts and runs none of ours - which is why DesignerJSClass stays df.WebButton while
   psJSClass names the client class. What the Designer does apply is a LITERAL psCSSClass, styled by the
   program's application.css: so a glyph shows there when the object names it as a class,
   Set psCSSClass to "ftbtn ftg-exit" (ftglyphs.css, which application.css imports). When the program
   runs, a psGlyph NAME becomes that same class, so both spellings draw alike. */

/* THE CLICK'S WORK WAITS FOR THE CLICK TO END - cFTClickRelay.pkg: OnClick only hands the button to the
   relay, and one tick later, after the web event has returned, OnButtonClick runs. */

// The glyph's markup: an image file when the value has a "." (a path under AppHtml), otherwise a
// DashIcon name - the same rule as cFTHtmlPage's psTitleIcon. "" = no glyph.
Function FTGlyphHtml Global String sGlyph Returns String
    Move (Trim(sGlyph)) to sGlyph
    If (sGlyph = "") ;
        Function_Return ""
    If (Pos(".", sGlyph) > 0) ;
        Function_Return (ImgHtml(sGlyph, "", "", ""))
    Function_Return (DashIcon(sGlyph))
End_Function

// Inherited from cWebButton; stated so the Designer models this class without the pooled package.
// The psCSSClass tag is for the Studio only. The Designer never runs End_Construct_Object, which puts
// "ftbtn" in front of the object's own class, so the tag tells it the class starts with it - and with
// ftcontrols.css imported by the program's CssStyle/application.css (the one sheet of ours the Designer
// loads), it draws the FT button. At run time psCSSClass still starts empty. The piColumnSpan tag tells
// it the button's width, which Construct_Object sets.
{ DesignerJSClass=df.WebButton }
{ OverrideProperty=psCSSClass InitialValue="ftbtn" }
{ OverrideProperty=piColumnSpan InitialValue=10 }
Class cFTWebButton is a cWebButton

    Procedure Construct_Object
        Forward Send Construct_Object

        // The picture in front of the caption: a DashIcon name (CS_GlyphClose), drawn by its ftg- class
        // (ftglyphs.css), or an image file under AppHtml ("Images/Logo.svg"). "" = none. Read when the
        // object is built - UpdateGlyph changes it later. The Studio's Designer shows a glyph only when
        // it is named in psCSSClass, "ftbtn ftg-close" - it never runs the code that reads this.
        { Category="Appearance" }
        Property String psGlyph ""
        // The main action: the amber variant of the FT look. Read when the object is built.
        { Category="Appearance" }
        Property Boolean pbPrimary False

        // The caption's font. "", 0 and False keep the FT look's own: Segoe UI, 12px, normal weight.
        // WebSet changes them while the program runs.
        { WebProperty=Client }
        { Category="Appearance" }
        Property String psFontFamily ""
        { WebProperty=Client }
        { Category="Appearance" }
        Property Integer piFontSize 0
        { WebProperty=Client }
        { Category="Appearance" }
        Property Boolean pbBold False

        // An image-file glyph as the client draws it - made from psGlyph, never set directly.
        { WebProperty=Client }
        { Visibility=Private }
        Property String psGlyphHtml ""

        // The object's own classes and the glyph's class, as End_Construct_Object sorted them; the class
        // list is put together again from these when the glyph changes (UpdateGlyph).
        { Visibility=Private }
        Property String psFTOwnClasses ""
        { Visibility=Private }
        Property String psFTGlyphClass ""

        // Its width on a grid host of 8 px columns (cFTGridHost): 10 of them, an 80 px cell - the
        // button inside is 70 px after its own 5 px margins (Nils 2026-09-28). A longer caption needs
        // more, and its object says so. In a flow host of 12 columns 10 is most of the row: a button
        // there says its piColumnSpan.
        Set piColumnSpan to 10

        Set psJSClass to "rdcft.FTWebButton"
    End_Procedure

    // The class list: the FT look, the main-action variant, the glyph's class, then the object's own.
    Function FTClassList Returns String
        String sList
        Move "ftbtn" to sList
        If (pbPrimary(Self)) ;
            Move (sList + " ftbtn-primary") to sList
        If (psFTGlyphClass(Self) <> "") ;
            Move (sList + " " + psFTGlyphClass(Self)) to sList
        If (psFTOwnClasses(Self) <> "") ;
            Move (sList + " " + psFTOwnClasses(Self)) to sList
        Function_Return sList
    End_Function

    // Is the button's page up? The library's one test (FTHostPageIsUp, FTPageIsUp.pkg): the host is active and
    // its page has called home. A WebSet at any other time has nowhere to go, and waits for the wrong page.
    Function FTPageIsUp Returns Boolean
        Handle hoHost
        Get Owner to hoHost
        Function_Return (FTHostPageIsUp(hoHost))
    End_Function

    // The class list, applied: stored for a page that loads (Set) and pushed to a page that is up (WebSet).
    Procedure FTApplyClasses
        String sList
        Move (FTClassList(Self)) to sList
        Set psCSSClass to sList
        If (FTPageIsUp(Self)) ;
            WebSet psCSSClass to sList
    End_Procedure

    Procedure End_Construct_Object
        String sGlyph sToken sOwn
        String[] asClasses
        Integer i
        Forward Send End_Construct_Object
        /* psCSSClass REPLACES the class list, it never adds to it, so the object's own classes are sorted
           and the list is put together again (FTClassList): "ftbtn" first, whatever the object set after
           it - a "FtFixedBtn" of DFRefactor's still wins its natural width, by !important. The spelling
           the Studio's Designer needs is understood too, since it runs none of this: an "ftbtn" in the
           object's list is not added twice, "ftbtn-primary" means pbPrimary, and an "ftg-<name>" class
           is the glyph. */
        Move (StrSplitToArray(Trim(psCSSClass(Self)), " ")) to asClasses
        Move "" to sOwn
        For i from 0 to (SizeOfArray(asClasses) - 1)
            Move asClasses[i] to sToken
            If (sToken = "ftbtn-primary") Begin
                Set pbPrimary to True
            End
            Else If (Left(sToken, 4) = "ftg-") Begin
                Set psFTGlyphClass to sToken
            End
            Else If ((sToken <> "ftbtn") and (sToken <> "")) Begin
                Move (Trim(sOwn + " " + sToken)) to sOwn
            End
        Loop
        Set psFTOwnClasses to sOwn
        // psGlyph, unless the class list named the glyph: a DashIcon NAME is its ftg- class, an image
        // file goes to the client as markup.
        Move (Trim(psGlyph(Self))) to sGlyph
        If ((psFTGlyphClass(Self) = "") and (sGlyph <> "")) Begin
            If (Pos(".", sGlyph) > 0) ;
                Set psGlyphHtml to (FTGlyphHtml(sGlyph))
            Else ;
                Set psFTGlyphClass to ("ftg-" + sGlyph)
        End
        Set psCSSClass to (FTClassList(Self))
    End_Procedure

    /* CHANGING THE LOOK WHILE THE PROGRAM RUNS (0.9.8, 2026-09-30). psGlyph and pbPrimary are read when the
       object is built; UpdateGlyph, UpdatePrimary and UpdateClasses change the glyph, the main action's amber
       and the object's own classes later - DFRefactor's Test Compile bar moves its amber "next step" from
       button to button as a compile, an analyze and a fix plan go by, and shows its Analyze Source in a teal
       class of its own. Each stores what it sets for a page that loads and pushes it to a page that is up
       (FTApplyClasses), so it can be sent at any time - before the page has called home too. */

    // A new glyph - the object body's psGlyph is read only when it is built. A DashIcon name becomes its ftg-
    // class, an image file goes to the client as markup, "" is none.
    Procedure UpdateGlyph String sGlyph
        String sGlyphHtml
        Move (Trim(sGlyph)) to sGlyph
        Set psGlyph to sGlyph
        If (Pos(".", sGlyph) > 0) Begin
            Set psFTGlyphClass to ""
            Move (FTGlyphHtml(sGlyph)) to sGlyphHtml
        End
        Else Begin
            Set psFTGlyphClass to (If(sGlyph = "", "", "ftg-" + sGlyph))
            Move "" to sGlyphHtml
        End
        Set psGlyphHtml to sGlyphHtml
        If (FTPageIsUp(Self)) ;
            WebSet psGlyphHtml to sGlyphHtml
        Send FTApplyClasses
    End_Procedure

    // The main action's amber on or off. Only a change is applied.
    Procedure UpdatePrimary Boolean bPrimary
        If (pbPrimary(Self) = bPrimary) ;
            Procedure_Return
        Set pbPrimary to bPrimary
        Send FTApplyClasses
    End_Procedure

    // The object's own classes - a variant of the look, say - in place of the ones it has, the ones it was
    // built with first; "" = none. Its own only: the FT look, the amber and the glyph stay as they are (use
    // UpdatePrimary and UpdateGlyph for those). Only a change is applied.
    Procedure UpdateClasses String sClasses
        Move (Trim(sClasses)) to sClasses
        If (psFTOwnClasses(Self) = sClasses) ;
            Procedure_Return
        Set psFTOwnClasses to sClasses
        Send FTApplyClasses
    End_Procedure

    /* THE STATE TOO (0.9.13, 2026-10-07): the caption, whether the button can be pressed (pbEnabled), whether it is
       shown at all (pbRender) and its tooltip, the same way - stored for a page that loads and pushed to a page that
       is up, and only when the value is new, so a refresh that runs on every tick of an idle handler or a timer
       pushes nothing while nothing changed. Until then every FT dialog of DFRefactor's had a setter of its own for
       these. A change made outside a web event reaches the page on the host's next idle tick; Send CheckUpdateWebUI
       of the host sends it now. */

    // The caption.
    Procedure UpdateCaption String sCaption
        If (psCaption(Self) = sCaption) ;
            Procedure_Return
        Set psCaption to sCaption
        If (FTPageIsUp(Self)) ;
            WebSet psCaption to sCaption
    End_Procedure

    // Whether the button can be pressed. A shut button says why in its tooltip (UpdateToolTip).
    Procedure UpdateEnabled Boolean bEnabled
        If (pbEnabled(Self) = bEnabled) ;
            Procedure_Return
        Set pbEnabled to bEnabled
        If (FTPageIsUp(Self)) ;
            WebSet pbEnabled to bEnabled
    End_Procedure

    // Whether the button is shown at all. A hidden one leaves its columns empty, so the buttons that come and go
    // sit last in their row.
    Procedure UpdateRender Boolean bRender
        If (pbRender(Self) = bRender) ;
            Procedure_Return
        Set pbRender to bRender
        If (FTPageIsUp(Self)) ;
            WebSet pbRender to bRender
    End_Procedure

    // The tooltip; "" is none.
    Procedure UpdateToolTip String sToolTip
        If (psToolTip(Self) = sToolTip) ;
            Procedure_Return
        Set psToolTip to sToolTip
        If (FTPageIsUp(Self)) ;
            WebSet psToolTip to sToolTip
    End_Procedure

    /* The framework's click, inside the WebView2 event. It only hands the button to the relay, so put
       a button's work in OnButtonClick. An object that overrides OnClick itself runs its code inside
       the click, as before this class had one - Forward it, or OnButtonClick never runs. */
    Procedure OnClick
        Forward Send OnClick
        Send Relay of (FTClickRelay()) Self
    End_Procedure

    // The button's work, after the web event has returned: a panel can open or close here.
    { MethodType=Event }
    Procedure OnButtonClick
    End_Procedure

    Procedure Request_Clear
    End_Procedure

End_Class
