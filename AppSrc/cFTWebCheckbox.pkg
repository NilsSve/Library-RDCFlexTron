Use cWebCheckBox.pkg

// Inherited from cWebCheckbox; stated so the Designer models this class without the pooled package.
{ DesignerJSClass=df.WebCheckbox }
Class cFTWebCheckbox is a cWebCheckbox
    
    Procedure Construct_Object
        Forward Send Construct_Object

            // The app's text size, not the framework's larger default - see FtCompact in application.css.
        Set psCSSClass to "FtCompact"
End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object

    End_Procedure

    Procedure Request_Clear
    End_Procedure
    
End_Class