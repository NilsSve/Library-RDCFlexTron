//****************************************************************************
// $Module type: Class Package
// $Module name: cFTWebList
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-28
//
// Description : FlexTron (FT) subclass of cWebList: the web list in the look of the FT tables, which asks
//               for its rows itself - rows from code (OnManualLoadData), or from a data dictionary.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cWebList.pkg
Use FTPageIsUp.pkg              // FTHostPageIsUp - can the host's page take a live push now?

/* THE LIST IN THE FT LOOK (Nils 2026-09-28: "build cFTWebList with a demo list"). The framework's own list -
   header, rows, selection, sorting, column resizing - in the look of the FT tables (ftcontrols.css, .ftlist):
   the header on the lifted card ground, the selected row in --dfr-row-sel-bg with an amber bar. On a grid
   host it takes a row like any control - the row that takes the extra height (psRowHeights "<row>/1fr"),
   with pbFillHeight. The Studio's Designer draws it with its columns, in the FT look too.

   ROWS FROM CODE: Set pbDataAware to False and fill the rows in OnManualLoadData - one tWebRow each, with a
   unique sRowId and one tWebCell per column, left to right; set sCurrentRowID to select one. The framework
   sends rows only when asked (GridRefresh), so the list asks for them itself the first time the page draws
   it: its client class, rdcft.FTWebList (ftcontrols.js), calls FTLoadRows. A page the host builds again
   asks again. New rows while the program runs: RefreshRows, which waits for the page.

   ROWS FROM A DATA DICTIONARY (0.9.21): Set Server and bind the columns with Entry_Item - pbDataAware is True
   by default - in a data-aware host (cFTDbGridHost). The framework reads the rows from the DD, and reads them
   again when the DD's record or its constraint changes. The FIRST rows the list asks for itself, as it does
   for rows from code: when the page comes up, a FlexTron host refreshes the controls of its own data
   dictionary (cDbLocalWebControlHost), and a list bound to another one - a child's rows, under the host's DD -
   is not among them. For a list on the host's own DD it is one read more.

   COLUMNS, the Windows way: a column with pbFixedWidth True is piWidth pixels wide; the columns without it
   share what is left, by their piWidth. So fixed columns and one that stretches, as in a Windows grid.

   The OverrideProperty tag tells the Studio the class's own look; the Set makes it so at run time. */
{ DesignerJSClass=df.WebList }
{ CompositeClass=cWebColumn }
{ OverrideProperty=psCSSClass InitialValue="ftlist" }
Class cFTWebList is a cWebList

    Procedure Construct_Object
        Forward Send Construct_Object

        // True: the list asks for its rows when the page draws it. Set when the object is built; never set
        // directly.
        { WebProperty=Client }
        { Visibility=Private }
        Property Boolean pbFTLoadOnShow False

        // The FT look - .ftlist in ftcontrols.css.
        Set psCSSClass to "ftlist"
        Set psJSClass to "rdcft.FTWebList"
    End_Procedure

    Procedure End_Construct_Object
        String sClasses
        Forward Send End_Construct_Object
        // psCSSClass REPLACES the class list: an object that sets its own keeps the FT look in front of it.
        Move (Trim(psCSSClass(Self))) to sClasses
        If (Pos(" ftlist ", (" " + sClasses + " ")) = 0) ;
            Set psCSSClass to (Trim("ftlist " + sClasses))
        // Rows from code and a bound list's alike: the list asks for them the first time the page draws it.
        Set pbFTLoadOnShow to True
        WebPublishProcedure FTLoadRows
    End_Procedure

    // Sent by the client (rdcft.FTWebList) the first time the page draws the list: its rows, from
    // OnManualLoadData or from its data dictionary - GridRefresh is the framework's own read of either.
    Procedure FTLoadRows
        Send GridRefresh
    End_Procedure

    // New rows while the program runs - from OnManualLoadData, or read again from the data dictionary. Unless
    // the page is up (FTHostPageIsUp: the host active, the page called home) it does nothing - the list asks
    // for its rows itself when the page draws it - because a GridRefresh that reaches a page which has not
    // built its controls yet breaks the page (cFTWebHtmlBox's UpdateHtml waits the same way).
    Procedure RefreshRows
        Handle hoHost
        Get Owner to hoHost
        If (FTHostPageIsUp(hoHost)) ;
            Send GridRefresh
    End_Procedure

End_Class
