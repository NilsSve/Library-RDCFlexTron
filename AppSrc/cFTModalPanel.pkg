//****************************************************************************
// $Module type: Class Package
// $Module name: cFTModalPanel
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : FlexTron variant of RDCToolsLib's cRDCModalPanel (Nils + Claude 2026-07-12). It adds the FT
//               ground colour, DataFlex's Default.ico as the default icon, and the dark CodeJock theme on the
//               dialog's status-bar command bar - which until 2026-07-12 lived as a local uncommitted patch
//               INSIDE the RDCToolsLib submodule (invisible, and one submodule update away from being lost).
//               A thin SUBCLASS rather than a copy: the library class stays the single source of the panel
//               behaviour, so this file cannot drift from it.
//               FlexTron dialogs declare 'is a cFTModalPanel'; non-FlexTron dialogs keep the plain class.
//               It fits one web host to itself, above its status bar (phoClientHost), as cFTPanel does.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cRDCModalPanel.pkg
Use cCJCommandBarSystem.pkg
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette

{ DDOHost=False }
{ DataAware=False }
{ DesignerClass=cDTModalPanel }
{ ComponentType=SLClass }
{ HelpTopic=ModalPanel }
Class cFTModalPanel is a cRDCModalPanel

    /* THE FT GROUND, set once. Every instance that stated a Color stated this one - not a single
       site anywhere picks a different colour - so it is the class's, not a per-object decision.
    
       It also reaches the handful that stated NOTHING and were therefore left on the framework's
       pale default: the native surround behind a dark web page. That is the same fault, on the
       native side, that piBackColor fixes on the WebView2 side in cFTThemeHost_mixin.pkg - and the same
       argument that comment makes: set it in the one place every FT surface passes through. */
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Color to (FTWebBg())
        // Built before the theme is known - a dialog Used above the application object: it waits for the
        // theme (FTThemeLater), and ApplyFTTheme colours it again as soon as the theme is read.
        If (giFTThemeMode = CI_FTThemeUnset) ;
            Send FTThemeLater Self
        // DataFlex's own Default.ico, unless the dialog names an icon of its own. After the Forward: the
        // base creates the property its Set Icon keeps the name in, and applies it again in Page.
        Set Icon to "Default.ico"

        // The web host that fills the panel above its status bar, or 0 for none. The dialog sets it below its
        // host object: Set phoClientHost to (oHost(Self)). A grid host (cFTGridHost) then lays out the rest.
        { DesignTime=False }
        Property Handle phoClientHost 0
        // The status bar's height, in dialog units: the host ends this far above the panel's bottom edge.
        { DesignTime=False }
        Property Integer piStatusBarUnits 20
    End_Procedure

    // The base's End_Construct_Object builds oDialogCommandbar > oStatusBar and stores the
    // STATUS BAR handle in phoDialogCommandbar (see the base's oStatusBar object). Theme the
    // command-bar SYSTEM - its parent - dark AFTER the forward; a CodeJock Set before COM
    // realization lands in the private store and is applied when the control realizes.
    Procedure End_Construct_Object
        Handle hoStatusBar
        Forward Send End_Construct_Object
        Get phoDialogCommandbar to hoStatusBar
        If (hoStatusBar <> 0) ;
            Set peVisualTheme of (Parent(hoStatusBar)) to (FTCJTheme())
    End_Procedure

    // The theme again, for a dialog built before it was known: the seed sends this as soon as it has read
    // the theme - before the dialog is shown (FTThemeLateObjects).
    Procedure ApplyFTTheme
        Handle hoStatusBar
        Set Color to (FTWebBg())
        Get phoDialogCommandbar to hoStatusBar
        If (hoStatusBar <> 0) ;
            Set peVisualTheme of (Parent(hoStatusBar)) to (FTCJTheme())
    End_Procedure

    /* PLACEHOST fits phoClientHost to the panel when it is shown and on every resize: from the host's own
       top-left offset (Set Location to 4 4), with the same margin at the right, down to the top of the
       status bar. It measures the panel's Size, in dialog units - a modal panel's Size is its client area (a
       main Panel's is not: cFTPanel measures pixels) - because the base panel grows itself for its status
       bar AFTER its children are constructed, so a host anchored to the bottom would end short of the bar.
       The demo's dialog and DFRefactor's message box placed their hosts this way before this class did.
       A panel of a fixed size has no status bar (cRDCModalPanel adds one to a Border_Thick panel only): its
       host ends the same margin above the bottom as below the top. */
    Procedure PlaceHost
        Handle hoHost
        Integer iSize iLoc iH iW iBottom
        Get phoClientHost to hoHost
        If (hoHost = 0) ;
            Procedure_Return
        Get Size to iSize
        Get Location of hoHost to iLoc
        Move (Hi(iLoc)) to iBottom
        If (phoDialogCommandbar(Self) <> 0) ;
            Move (piStatusBarUnits(Self)) to iBottom
        Move (Hi(iSize) - iBottom - Hi(iLoc)) to iH
        Move (Low(iSize) - (2 * Low(iLoc))) to iW
        If (iH < 40) ;
            Move 40 to iH
        Set Size of hoHost to iH iW
    End_Procedure

    Procedure Activating
        Forward Send Activating
        Send PlaceHost
    End_Procedure

    Procedure OnResize
        Forward Send OnResize
        Send PlaceHost
    End_Procedure

End_Class
