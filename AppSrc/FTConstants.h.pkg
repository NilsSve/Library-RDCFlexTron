//****************************************************************************
// $Module type: Package
// $Module name: FTConstants.h
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-23
//
// Description : The FlexTron layer's own constants: the theme values, the theme global, where the
//               theme choice is saved, the colours of the native side, the whole HTML tags the markup
//               builders go with, the named HTML entities, and the links to the library's style sheets.
//
//               They lived in RefactorConstants.h.pkg until 2026-09-23. Here, the reusable FT packages -
//               the web controls, both hosts, both modal panels, the theme mixin, FTThemeColors and
//               cFTApplication - compile without any DFRefactor file, so another workspace can Use them.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use Windows.pkg     // RGB and clWhite, which the dark colours below are made of
Use Rgb.pkg

// THE PACKAGE VERSION, as RDC-FlexTron-Library.sws states it in "package"."version" - keep the two
// equal. Every FT host page links ftcontrols.css / ftcontrols.js with it as ?v=, because WebView2
// keeps a copy of what it loaded, and a new version of the library must not be served the old one.
Define CS_FTLibraryVersion for "0.9.16"

// The one source of truth for the above, seeded from the saved setting on first use.
// Re-read by Send ApplyFTTheme, which is what a runtime switch would broadcast.
Global_Variable Integer giFTThemeMode

// Which theme the FlexTron web hosts render in. Deliberately OUR OWN values rather than the
// framework's tpLightMode / tpDarkMode / tpSystemPreference: ZERO has to mean "not read from the
// settings yet", and the framework enum has no such value. cFTThemeHost_mixin.pkg maps ours onto
// the framework's in ApplyFTTheme. Explicit values, not an Enum_List, for the same reason.
//
// The theme cannot be seeded from OnStartup: that runs after every object already exists, by which
// time the view hosts have long since constructed. So cFTApplication reads it as soon as the
// application object exists (SeedFTTheme), and the first host to construct reads it if nothing has -
// one registry read, not one per host.
Define CI_FTThemeUnset  for 0   // nothing has read the setting yet
Define CI_FTThemeDark   for 1
Define CI_FTThemeLight  for 2
Define CI_FTThemeSystem for 3   // follow Windows; the framework watches prefers-color-scheme live

// WHERE THE THEME CHOICE IS SAVED: a value under the program's own registry key, read and written
// with ReadInteger / WriteInteger of ghoApplication. DFRefactor keeps it in Settings\FTTheme. A
// program that wants it elsewhere defines either constant BEFORE its first Use of this package.
#IFNDEF CS_FTThemeSection
    Define CS_FTThemeSection for "Settings"
#ENDIF
#IFNDEF CS_FTTheme
    Define CS_FTTheme        for "FTTheme"      // CI_FTTheme* - dark/light/follow-Windows
#ENDIF

// THE DARK COLOURS of the native side - the panels, hosts and margins around the web content.
// FTThemeColors.pkg returns them while the theme is dark. They lived in DFRefactorFT.src until
// 2026-08-13 and in RefactorConstants.h.pkg until 2026-09-23.
//
// The web side of clDarkViewBg and clDarkWebBg is palette.css, which the package installs as
// AppHtml/RDCFlexTron/palette.css (--dfr-bg-card-hi and
// --dfr-bg-page). Change one, change its twin, or the native panels drift away from the web bars
// they sit next to.
#IFNDEF clDarkTheme
    Define clDarkTheme for (RGB(36,36,36))
    Define clDarkThemeText for clWhite
#ENDIF

#IFNDEF clDarkViewBg
    // The FT views' dark tint = the dashboard's warm card colour #31302E. clDarkTheme (#242424)
    // read as pitch-black across a whole view, so the FT view/dialog files use this lighter grey.
    Define clDarkViewBg for (RGB(49, 48, 46))       // HTML #31302E = var(--dfr-bg-card-hi)

    // The web host backdrop #262624 - the dashboard's page background, painted globally by
    // application.css. Hosted cLocalWebControlHost bars render on this, and there is no per-host
    // CSS hook to recolour just one host - so a native panel sitting AMONG web bars uses THIS
    // (not clDarkViewBg) to read as one surface with them.
    Define clDarkWebBg for (RGB(38, 38, 36))        // HTML #262624 = var(--dfr-bg-page)
#ENDIF

// THE LIGHT COLOURS - the same four roles while the theme is light; FTThemeColors.pkg returns them then.
// Their web twins are palette.css under body.df-Light: --dfr-bg-page, --dfr-bg-card-hi and --dfr-ink.
// Every colour of the native side is a Define here - the functions only choose between the pairs.
#IFNDEF clLightTheme
    Define clLightTheme     for (RGB(247, 245, 240))    // the flat theme ground, HTML #F7F5F0
    Define clLightThemeText for (RGB(42, 40, 37))       // HTML #2A2825 = var(--dfr-ink)
    Define clLightViewBg    for (RGB(255, 255, 255))    // HTML #FFFFFF = var(--dfr-bg-card-hi)
    Define clLightWebBg     for (RGB(247, 245, 240))    // HTML #F7F5F0 = var(--dfr-bg-page)
#ENDIF

// THE WHOLE HTML TAGS - the closing halves of what FTMarkupBuilders' DivOpen, SpanOpen and TagText open, the
// lone openings, and the line break. A tag that carries a class has no constant: half a tag would leave the
// class dangling at the call site - that is DivOpen("cls"). CS_ParaOpen is for a <p> whose </p> a later
// statement appends; a whole paragraph is TagText("p", ...). They moved here from DFRefactor's
// RefactorConstants.h.pkg (2026-09-28), with the same names and values.
Define CS_DivOpen                   for "<div>"
Define CS_DivEnd                    for "</div>"
Define CS_SpanOpen                  for "<span>"
Define CS_SpanEnd                   for "</span>"
Define CS_ParaOpen                  for "<p>"
Define CS_ParaEnd                   for "</p>"
Define CS_Br                        for "<br>"
// The other tags FT markup is written with (2026-09-28). Each is named after the builder that makes its
// whole element, where there is one - BoldText, CodeText, HelpHeading, BulletList, BulletItem, TableHtml,
// RowHtml, CellHtml, HeadCellHtml; these are for markup built a piece at a time: the opening, what a loop
// appends, the closing. No <i>: in FT markup it is a shape, never italics, and ShapeHtml builds it whole.
Define CS_BoldOpen                  for "<b>"
Define CS_BoldEnd                   for "</b>"
Define CS_CodeOpen                  for "<code>"       // a name or a value inside a sentence
Define CS_CodeEnd                   for "</code>"
Define CS_CodeBlockOpen             for "<pre>"        // lines of code, or a path: spaces and line breaks show as written
Define CS_CodeBlockEnd              for "</pre>"
Define CS_HeadingOpen               for "<h4>"         // the heading of a help panel - HelpHeading's level
Define CS_HeadingEnd                for "</h4>"
Define CS_BulletListOpen            for "<ul>"
Define CS_BulletListEnd             for "</ul>"
Define CS_BulletItemOpen            for "<li>"
Define CS_BulletItemEnd             for "</li>"
Define CS_TableOpen                 for "<table>"
Define CS_TableEnd                  for "</table>"
Define CS_RowOpen                   for "<tr>"
Define CS_RowEnd                    for "</tr>"
Define CS_CellOpen                  for "<td>"
Define CS_CellEnd                   for "</td>"
Define CS_HeadCellOpen              for "<th>"
Define CS_HeadCellEnd               for "</th>"
Define CS_DetailsOpen               for "<details>"    // a section that folds open and shut
Define CS_DetailsEnd                for "</details>"
Define CS_SummaryOpen               for "<summary>"    // its title line - the part that is always shown
Define CS_SummaryEnd                for "</summary>"
Define CS_StyleOpen                 for "<style>"      // CSS written into the page itself
Define CS_StyleEnd                  for "</style>"
// Two ordinary characters an attribute cannot hold as they are: a new line inside title="", and an
// apostrophe inside a single-quoted DataFlex literal.
Define CS_NlEntity                  for "&#10;"
Define CS_AposEntity                for "&#39;"

// THE NAMED CHARACTERS. An entity writes a character by its name (&mdash;) or its number (&#9888;), which keeps
// the source plain ASCII - and tells a reader who does not write HTML nothing; the constant says what the
// character is. They moved here from DFRefactor's RefactorConstants.h.pkg (2026-09-28), with the same names and
// values. The escapes (&amp; &lt; &gt; &quot;) have none: text is escaped by FTHtmlEscape and CodeText, not by
// hand.
Define CS_EmDash                    for "&mdash;"
Define CS_MidDot                    for "&middot;"
Define CS_Nbsp                      for "&nbsp;"       // a space a line never breaks at
Define CS_Ellipsis                  for "&hellip;"
Define CS_Check                     for "&#10003;"     // U+2713 check mark
Define CS_RArrow                    for "&rarr;"       // right arrow
Define CS_Times                     for "&times;"      // the multiplication sign - a small cross
Define CS_Bullet                    for "&bull;"
Define CS_WarnSign                  for "&#9888;"      // U+26A0 warning triangle
Define CS_PlayTriangle              for "&#9654;"      // U+25B6 right-pointing triangle - "run this"
Define CS_UpTriangle                for "&#9650;"      // U+25B2 - a count that went up
Define CS_DownTriangle              for "&#9660;"      // U+25BC - and one that went down

// THE LIBRARY'S STYLE SHEETS, as a page links them - the package installs them into AppHtml\RDCFlexTron. A
// cFTWebHtmlBox fragment is a document of its own and does not inherit application.css, so it links them
// itself: CS_PaletteCssLink first - the link order is the cascade - then CS_PageFitCssLink for a fragment
// that fills its host exactly and never scrolls, CS_PillsCssLink for the status pills, and the program's own
// sheets last (CssLink).
//
// CS_PaletteCssLink is ONE plain literal, on purpose: DFRefactor's RefactorConstants.h.pkg defines it too, the
// same way. Two Defines of one name compile in either Use order only as the same plain literal; a Define of an
// expression - even one literal in parentheses - followed by the literal is error 4332.
Define CS_PaletteCssLink for '<link rel="stylesheet" href="RDCFlexTron/palette.css"><link rel="stylesheet" href="RDCFlexTron/buttons.css"><link rel="stylesheet" href="RDCFlexTron/bars.css">'
Define CS_PageFitCssLink            for '<link rel="stylesheet" href="RDCFlexTron/pagefit.css">'
Define CS_PillsCssLink              for '<link rel="stylesheet" href="RDCFlexTron/pills.css">'

// AN APPLICATION'S OWN GLYPHS (FTAppGlyphs.pkg): the SVG files in this folder of its AppHtml, and the sheet the
// program writes into it for them - their classes, for the Studio's Designer.
Define CS_FTAppGlyphFolder          for "FTGlyphs"
Define CS_FTAppGlyphSheet           for "ftglyphs-app.css"
