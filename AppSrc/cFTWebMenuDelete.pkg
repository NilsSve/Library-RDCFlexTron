//
// Description : Delete in a dialog's action menu (cFTActionBarHost): deletes through the grid, field or
//               data-aware host that had the focus before the menu - DataFlex's cCJDeleteMenuItem, as an FT
//               menu item.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cFTWebMenuItem.pkg

/* DELETE, ON THE OBJECT THE FOCUS CAME FROM (cFTActionBarHost, ActionTarget): a CodeJock grid deletes its row
   (when its pbAllowDeleteRow is True), a field or a data-aware FT host the record of its data dictionary. The
   question is the target's own, as for every Windows delete: its Verify_Delete_Msg - FTDelete_Confirmation and
   FTLine_Delete_Confirmation (FTMessageBox.pkg) ask it in the FT look. The focus goes back there first. */
{ DesignerJSClass=df.WebMenuItem }
{ OverrideProperty=psCaption InitialValue="Delete" }
{ OverrideProperty=psCSSClass InitialValue="ftg-delete" }
Class cFTWebMenuDelete is a cFTWebMenuItem

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psCaption to "Delete"
        Set psCSSClass to "ftg-delete"
        Set psToolTip to "Delete the row or the record you are in"
    End_Procedure

    Procedure OnItemClick
        Handle hoTarget
        Get ActionTarget to hoTarget        // the menu's host (cFTActionBarHost) answers
        If (hoTarget = 0) ;
            Procedure_Return
        Send Activate of hoTarget
        Send Request_Delete of hoTarget
    End_Procedure

End_Class
