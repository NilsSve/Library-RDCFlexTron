//
// Description : FlexTron (FT) subclass of cWebCombo: theme-aware behaviour for the FT build.
//               FT twin files are the privacy boundary - never merge them.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cWebCombo.pkg
Use FTPageIsUp.pkg      // FTHostPageIsUp - can the host's page take a live push now?

// Inherited from cWebCombo; stated so the Designer models this class without the pooled package. The
// psCSSClass, peLabelAlign and piColumnSpan tags are for the Studio: its Designer runs none of this code,
// so they tell it the class's own look - FtCompact (ftcontrols.css, which the program's application.css
// imports) - and its width.
{ DesignerJSClass=df.WebCombo }
{ OverrideProperty=psCSSClass InitialValue="FtCompact" }
{ OverrideProperty=peLabelAlign InitialValue=alignRight }
{ OverrideProperty=piColumnSpan InitialValue=20 }
Class cFTWebCombo is a cWebCombo

    Procedure Construct_Object
        Forward Send Construct_Object

        // True while the framework fills the list for a page it is building (PreSerializeObject).
        { Visibility=Private }
        Property Boolean pbFTFillForPage False

        Set pbServerOnChange to True
        Set peLabelAlign to alignRight
        // Its width on a grid host of 8 px columns: 20 of them, 160 px - a Windows combo's (Nils 2026-09-28).
        // In a flow host of 12 columns 20 does not fit, so the framework gives the combo the whole row,
        // from column 0: a combo there says its piColumnSpan.
        Set piColumnSpan to 20
        // The FT look - the app's text size, in the palette's colours: FtCompact in ftcontrols.css.
        Set psCSSClass to "FtCompact"
    End_Procedure

    // psCSSClass REPLACES the class list: an object that sets its own keeps the FT look in front of it.
    Procedure End_Construct_Object
        String sClasses
        Forward Send End_Construct_Object
        Move (Trim(psCSSClass(Self))) to sClasses
        If (Pos(" FtCompact ", (" " + sClasses + " ")) = 0) ;
            Set psCSSClass to (Trim("FtCompact " + sClasses))
    End_Procedure

    Procedure Request_Clear
    End_Procedure

    /* A REFILL GOES TO A PAGE THAT IS UP, OR TO NONE (0.9.25). The framework's Refill asks nothing: it fills
       the list (FillFromDDO, OnFill) and queues a "fill" for the client, every time. Sent while the host's
       page is not up - a view that is not on screen is told that the data changed - the message waits on the
       host and goes out with the host's next page, where the combo may not have been built yet: "Could not
       find object '<the combo>'", error 999. DFRefactor's Program picker met it (Nils 2026-10-12): a
       workspace opened in one view, then the view with the picker shown. A race, so it shows only
       sometimes. The library's own pushes have asked FTHostPageIsUp since 0.9.24; this one is the
       framework's, so it had no test.

       Nothing is lost by leaving it out. The framework fills every combo itself as it builds a page -
       PreSerializeObject sends Refill - with the data of that moment, and that fill is part of the page's
       own load: it always goes through (pbFTFillForPage). A refill for a page that is up goes through as
       before. */
    Procedure Refill
        Handle hoHost
        If (not(pbFTFillForPage(Self))) Begin
            Get Owner to hoHost
            If (not(FTHostPageIsUp(hoHost))) ;
                Procedure_Return
        End
        Forward Send Refill
    End_Procedure

    Procedure PreSerializeObject
        Set pbFTFillForPage to True
        Forward Send PreSerializeObject
        Set pbFTFillForPage to False
    End_Procedure
End_Class