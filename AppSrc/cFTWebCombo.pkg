// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cWebCombo.pkg

// Inherited from cWebCombo; stated so the Designer models this class without the pooled package. The
// psCSSClass, peLabelAlign and piColumnSpan tags are for the Studio: its Designer runs none of this code,
// so they tell it the class's own look - FtCompact (ftcontrols.css, which the program's application.css
// imports) - and its width.
{ DesignerJSClass=df.WebCombo }
{ OverrideProperty=psCSSClass InitialValue="FtCompact" }
{ OverrideProperty=peLabelAlign InitialValue=alignRight }
{ OverrideProperty=piColumnSpan InitialValue=20 }
Class cFTWebCombo is a cWebCombo

    Procedure Construct_Object
        Forward Send Construct_Object

        Set pbServerOnChange to True
        Set peLabelAlign to alignRight
        // Its width on a grid host of 8 px columns: 20 of them, 160 px - a Windows combo's (Nils 2026-09-28).
        // In a flow host of 12 columns 20 does not fit, so the framework gives the combo the whole row,
        // from column 0: a combo there says its piColumnSpan.
        Set piColumnSpan to 20
        // The FT look - the app's text size, in the palette's colours: FtCompact in ftcontrols.css.
        Set psCSSClass to "FtCompact"
    End_Procedure

    // psCSSClass REPLACES the class list: an object that sets its own keeps the FT look in front of it.
    Procedure End_Construct_Object
        String sClasses
        Forward Send End_Construct_Object
        Move (Trim(psCSSClass(Self))) to sClasses
        If (Pos(" FtCompact ", (" " + sClasses + " ")) = 0) ;
            Set psCSSClass to (Trim("FtCompact " + sClasses))
    End_Procedure

    Procedure Request_Clear
    End_Procedure
End_Class