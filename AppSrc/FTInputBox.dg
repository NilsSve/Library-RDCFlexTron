//****************************************************************************
// $Module type: Dialog
// $Module name: FTInputBox
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-29
//
// Description : The dialog FTInputBox shows (FTInputBox.pkg): the message in a page - its caption as the
//               title, beside a pencil - one field under it, and the answer at the bottom right. Use it
//               anywhere, above the application object too.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cFTModalPanel.pkg
Use cFTLocalWebControlHost.pkg      // a web control needs a host Used before it
Use cFTGridHost.pkg                 // the host as a grid of 8 px columns
Use FTAllWebControlClasses.pkg      // cFTWebButton, cFTWebForm
Use cFTHtmlPage.pkg                 // the message's page: its title (psLabel) and the glyph beside it
Use Winkern.pkg                     // GetTickCount
Use FTInputBox.pkg                  // ghoFTInputBox, and FTMessageBox.pkg's FTMessageBoxText

/* THE INPUT BOX - one message, ONE field and a fixed row of buttons, nothing else: FTMessageBox.dg with a field
   under the message. A dialog of its own rather than a field the message box can show (Nils 2026-08-15: a
   shared dialog is only OK "if the buttons stay the same, and there is only one set of buttons").

   THE FIELD'S TEXT is read inside a web event, where the client's value is current: in Yes's OnClick, before
   the click relay runs its OnButtonClick, and in the field's OnKey when Enter is pressed. Enter answers Yes
   through the same relay, so the panel closes after the web event has returned (4410). */
Object oFTInputBox is a cFTModalPanel
    Set Label to "Input"
    Set Size to 198 420
    Set piMinSize to 198 420
    Set Location to 2 2
    Set Locate_Mode to Center_On_Panel
    // A fixed size, as Windows' own message box has; see FTMessageBox.dg.
    Set Border_Style to Border_Dialog
    Set Maximize_Icon to False

    // The answer: True for the first button or Enter, False for the second or Esc.
    Property Boolean pbYes False
    // What the next showing puts on the page, in the field and on the buttons: FTShowInput sets them,
    // Activating shows them. psFTValue comes back holding what was typed.
    Property String psFTTitle ""
    Property String psFTBodyHtml ""
    Property String psFTInputLabel ""
    Property String psFTValue ""
    Property String psFTYesLabel "OK"
    Property String psFTNoLabel "Cancel"
    // WHEN THIS BOX LAST CLOSED - a box popped again a moment after it closed settles first (FTMessageBox.dg).
    Property Integer piClosedTick 0

    // An answer: the buttons send it, after the web click has returned. It ends the panel.
    Procedure FTAnswer Boolean bYes
        Set pbYes to bYes
        Send Close_Panel
        Set piClosedTick to (GetTickCount())
    End_Procedure

    Object oIbHost is a cFTGridHost
        Set Location to 4 4
        Set Size to 174 412
        Set peAnchors to anNone         // placed by cFTModalPanel (phoClientHost)
        Set piColumnCount to 21         // column 0, then No's 10 and Yes's 10
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width
        Set psRowHeights to "0/1fr 2/8px"   // row 0, the message, takes the extra height; row 2 is 8 px of air

        // Row 0: the message. Its caption is the page's title, beside a pencil.
        Object oIbPage is a cFTHtmlPage
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 21
            Set pbFillHeight to True        // a long message scrolls in the page
            Set psLabel to "Input"
            Set psCSSClass to "ftpage ftg-edit"
        End_Object

        // Row 1: the field, in line with the message's text (ftinput, ftcontrols.css).
        Object oIbForm is a cFTWebForm
            Set piRowIndex to 1
            Set piColumnIndex to 0
            Set piColumnSpan to 21
            Set psLabel to "Name:"
            Set peLabelAlign to alignLeft
            Set piLabelOffset to 60
            Set psCSSClass to "ftinput"
            Set pbServerOnKey to True       // for Enter - OnKey below

            // Enter answers the first button: the text is current here, in the web event; the answer runs
            // after it (FTEnter).
            Procedure OnKey Boolean bPrintable String sKey
                String sValue
                Forward Send OnKey bPrintable sKey
                If (sKey = "Enter") Begin
                    WebGet psValue to sValue
                    Set psFTValue of (oFTInputBox(Self)) to sValue
                    Send FTEnter of (oFTInputBox(Self))
                End
            End_Procedure
        End_Object

        // Row 3: the answer at the bottom right. A check on the first button, an x on the second.
        Object oIbNoBtn is a cFTWebButton
            Set piRowIndex to 3
            Set piColumnIndex to 1
            Set piColumnSpan to 10
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-close"

            Procedure OnButtonClick
                Send FTAnswer False
            End_Procedure
        End_Object

        Object oIbYesBtn is a cFTWebButton
            Set piRowIndex to 3
            Set piColumnIndex to 11
            Set piColumnSpan to 10
            Set psCaption to "OK"
            Set psCSSClass to "ftbtn ftbtn-primary ftg-check"

            // The field's text is current here, in the web event - the relay runs OnButtonClick after it.
            Procedure OnClick
                String sValue
                WebGet psValue of (oIbForm(Self)) to sValue
                Set psFTValue of (oFTInputBox(Self)) to sValue
                Forward Send OnClick
            End_Procedure

            Procedure OnButtonClick
                Send FTAnswer True
            End_Procedure
        End_Object
    End_Object

    // cFTModalPanel fits the host to the panel, when it is shown and on every resize.
    Set phoClientHost to (oIbHost(Self))

    // Enter in the field: the first button's answer, after the web event has returned - the click relay.
    Procedure FTEnter
        If (ghoFTClickRelay <> 0) ;
            Send Relay of ghoFTClickRelay (oIbYesBtn(oIbHost(Self)))
    End_Procedure

    /* What this showing says - stored, so a page that loads shows it, and pushed to a page that is up already:
       the two ways an FT dialog's content reaches its page. The label column fits the label. */
    Procedure Activating
        Handle hoHost hoPage hoForm hoNo hoYes
        Boolean bInitializing
        Integer iOffset
        String sNo
        Forward Send Activating
        Move (oIbHost(Self)) to hoHost
        Move (oIbPage(hoHost)) to hoPage
        Move (oIbForm(hoHost)) to hoForm
        Move (oIbNoBtn(hoHost)) to hoNo
        Move (oIbYesBtn(hoHost)) to hoYes
        Move (psFTNoLabel(Self)) to sNo
        Move ((Length(psFTInputLabel(Self)) * 7) + 14) to iOffset
        Set psLabel of hoPage to (psFTTitle(Self))
        Set psHtml of hoPage to (psFTBodyHtml(Self))
        Set psLabel of hoForm to (psFTInputLabel(Self))
        Set piLabelOffset of hoForm to iOffset
        Set psValue of hoForm to (psFTValue(Self))
        Set psCaption of hoYes to (psFTYesLabel(Self))
        Set psCaption of hoNo to sNo
        Set pbRender of hoNo to (sNo <> "")
        Get pbInitWebApp of hoHost to bInitializing
        If (not(bInitializing)) Begin
            WebSet psLabel of hoPage to (psFTTitle(Self))
            Send UpdateHtml of hoPage (psFTBodyHtml(Self))
            WebSet psLabel of hoForm to (psFTInputLabel(Self))
            WebSet piLabelOffset of hoForm to iOffset
            WebSet psValue of hoForm to (psFTValue(Self))
            WebSet psCaption of hoYes to (psFTYesLabel(Self))
            WebSet psCaption of hoNo to sNo
            WebSet pbRender of hoNo to (sNo <> "")
            Send Activate of hoForm         // the caret in the field, on a page that is up already
        End
    End_Procedure

    // Esc declines, as the message box's does.
    Procedure Cancel
        Set pbYes to False
        Forward Send Cancel
        Set piClosedTick to (GetTickCount())
    End_Procedure

    /* THE one call - FTInputBox (FTInputBox.pkg) sends it: the caption, the message in HTML, the field's label,
       its starting text, and the two button captions - sNoLabel "" for one button. Returns True for the first
       button or Enter; FTInputValue then has the text. */
    Function FTShowInput String sTitle String sBodyHtml String sInputLabel String sValue String sYesLabel ;
                         String sNoLabel Returns Boolean
        Integer iWait
        String sApp
        If (Trim(sTitle) = "") ;
            Move "Input" to sTitle
        If (sYesLabel = "") ;
            Move "OK" to sYesLabel
        /* NEVER NESTED: this is one object, and a second call while it shows would pop the same panel over
           itself. Windows has no box that asks for text, so that one is declined. */
        If (Active_State(Self)) ;
            Function_Return False
        // A box that has just closed settles before it pops again (piClosedTick).
        Move 0 to iWait
        While (((GetTickCount() - piClosedTick(Self)) < 150) and (iWait < 40))
            Send PumpMsgQueue of Desktop
            Increment iWait
        Loop
        // The window's title is the program's name; the caption is the page's.
        Move "" to sApp
        If (ghoApplication <> 0) ;
            Get psProduct of ghoApplication to sApp
        If (Trim(sApp) = "") ;
            Move sTitle to sApp
        Set Label to sApp
        Set psFTTitle to sTitle
        Set psFTBodyHtml to ((DivOpen("ftmsg")) + sBodyHtml + CS_DivEnd)
        Set psFTInputLabel to sInputLabel
        Set psFTValue to sValue
        Set psFTYesLabel to sYesLabel
        Set psFTNoLabel to sNoLabel
        Set pbYes to False
        // A long message gets the tall box, as in the message box.
        If (Length(FTMessageBoxText(sBodyHtml)) > 600) Begin
            Set Size to 278 460
            Set piMinSize to 278 460
        End
        Else Begin
            Set Size to 198 420
            Set piMinSize to 198 420
        End
        Send Popup
        Function_Return (pbYes(Self))
    End_Function

    // What was typed, when the last showing was answered with the first button.
    Function FTInputValue Returns String
        Function_Return (psFTValue(Self))
    End_Function
End_Object

// FTInputBox.pkg reaches the dialog through this handle.
Move (oFTInputBox(Self)) to ghoFTInputBox
