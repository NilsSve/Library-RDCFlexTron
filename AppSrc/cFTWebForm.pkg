Use cWebForm.pkg
Use cFTClickRelay.pkg          // the prompt list opens after the web event has returned
Use FTNativePrompt.pkg         // FTNativePromptList - the list inside the DD's prompt panel

// Inherited from cWebForm; stated so the Designer models this class without the pooled package. The
// psCSSClass and peLabelAlign tags are for the Studio: its Designer runs none of this code, so they
// tell it the class's own look - FtCompact (ftcontrols.css, which the program's application.css imports).
{ DesignerJSClass=df.WebForm }
{ OverrideProperty=psCSSClass InitialValue="FtCompact" }
{ OverrideProperty=peLabelAlign InitialValue=alignRight }
Class cFTWebForm is a cWebForm

    Procedure Construct_Object
        Forward Send Construct_Object

        Set peLabelAlign to alignRight
        Set pbServerOnChange to True
        // The FT look - the app's text size, in the palette's colours: FtCompact in ftcontrols.css.
        Set psCSSClass to "FtCompact"
        // 11 of the 12 forms sat in column 0; the one that does not sets 4 and still does.
        Set piColumnIndex to 0
    End_Procedure

    // psCSSClass REPLACES the class list: an object that sets its own keeps the FT look in front of it.
    Procedure End_Construct_Object
        String sClasses
        Forward Send End_Construct_Object
        Move (Trim(psCSSClass(Self))) to sClasses
        If (Pos(" FtCompact ", (" " + sClasses + " ")) = 0) ;
            Set psCSSClass to (Trim("FtCompact " + sClasses))
    End_Procedure

    Procedure Request_Clear
    End_Procedure

    /* THE FIELD'S PROMPT LIST, as a native field has it (Nils 2026-11-14: "this should not be a special solution
       for this particular case, but always be the case"). A data dictionary names a field's prompt list - a
       native one, Field_Prompt_Object, a panel with a cDbCJGridPromptList - and a native form takes F4, the
       toolbar's Prompt and the list from it. The web framework knows only a WEB prompt list
       (Field_WebPrompt_Object), and two gaps were left for a web field in a FlexTron host:
       - F4 and the prompt button. The page's script fires OnPrompt for a field WITH a prompt button only, and the
         framework turns the button on for a web prompt list only. Attach_Deo_To_Server, below, turns it on for a
         native one as well.
       - The toolbar's Prompt (cCJPromptMenuItem) asks the focused control - this field, in a data-aware host -
         for Prompt_Object, the desktop name, with delegation off. The web classes answer only PromptObject, so
         the button stayed shut. Prompt_Object, below, answers with either list.
       Prompt opens the native list after the web event has returned (a modal panel from inside it faults), as
       non-invoking - it cannot fill a web field - and finds the chosen record in this field's data dictionary,
       as the list itself does for a native field (OnMoveValueOutByRelational). Every field bound to the record
       shows it. A web prompt list stays the framework's. A field that sets pbPromptButton itself keeps it. */

    // The panel the data dictionary names as this field's native prompt list, when it holds a cDbCJGridPromptList
    // and the field has no web prompt list; else 0.
    Function FTNativePromptPanel Returns Handle
        Handle hoDD hoPanel
        Integer iFile iField
        If (PromptObject(Self) <> 0) Begin
            Function_Return 0
        End
        Get Server to hoDD
        Get Data_File to iFile
        Get Data_Field to iField
        If ((hoDD = 0) or (iFile = 0)) Begin
            Function_Return 0
        End
        Get File_Field_Prompt_Object of hoDD iFile iField to hoPanel
        If (FTNativePromptList(hoPanel) = 0) Begin
            Function_Return 0
        End
        Function_Return hoPanel
    End_Function

    Procedure Attach_Deo_To_Server
        Integer iValue
        Forward Send Attach_Deo_To_Server
        Get pbPromptButton to iValue
        If (iValue = C_WebDefault) Begin
            If (FTNativePromptPanel(Self) <> 0) Begin
                Set pbPromptButton to True
            End
        End
    End_Procedure

    // The toolbar's Prompt asks for this, by its desktop name: a web prompt list or a native one.
    Function Prompt_Object Returns Handle
        Handle hoPrompt
        Get PromptObject to hoPrompt
        If (hoPrompt = 0) Begin
            Get FTNativePromptPanel to hoPrompt
        End
        Function_Return hoPrompt
    End_Function

    // The list's column bound to the same table and column as this field (piBindingTable, piBindingColumn), or -1.
    Function FTPromptColumnFor Handle hoList Integer iFile Integer iField Returns Integer
        Handle hoColumn
        Integer i iCount
        Get ColumnCount of hoList to iCount
        For i from 0 to (iCount - 1)
            Get ColumnObject of hoList i to hoColumn
            If ((piBindingTable(hoColumn) = iFile) and (piBindingColumn(hoColumn) = iField)) Begin
                Function_Return i
            End
        Loop
        Function_Return -1
    End_Function

    // The native list, on the relay's tick: not invoked by a field, and the chosen record found in this field's
    // data dictionary - the DD of the list's file in its tree. The list's own update mode is put back after.
    Procedure FTOpenNativePrompt
        Handle hoPanel hoList hoDD hoTarget
        Integer eOldMode iFile iMyFile iMyField iColumn iOldColumn
        Boolean bCanceled bFound bSeed
        String sValue
        RowID[] riSelected
        Get FTNativePromptPanel to hoPanel
        If (hoPanel = 0) Begin
            Procedure_Return
        End
        Move (FTNativePromptList(hoPanel)) to hoList
        Get Server to hoDD
        Get peUpdateMode of hoList to eOldMode
        Set peUpdateMode of hoList to umPromptNonInvoking
        /* SEEDED AS A NATIVE FIELD'S LIST IS (Nils 2026-11-19: with a record in the view, F4 should open the list at
           it). A list that is not invoked by a field seeds itself from psSeedValue through its update column
           (cDbCJGridPromptList's SeedData), and neither is set for it - so it opened at its first row. When the list
           seeds (pbAutoSeed), its update column is, for this prompt, the column bound to this field's table and
           column, and the seed is the field's current value: what a native field's umPromptValue list does. The
           list clears psSeedValue itself once it has loaded; its update column is put back afterwards. */
        Move False to bSeed
        Get Data_File to iMyFile
        Get Data_Field to iMyField
        If (pbAutoSeed(hoList)) Begin
            Get FTPromptColumnFor hoList iMyFile iMyField to iColumn
            If (iColumn >= 0) Begin
                Move True to bSeed
                Get piUpdateColumn of hoList to iOldColumn
                Set piUpdateColumn of hoList to iColumn
                Get File_Field_Current_Value of hoDD iMyFile iMyField to sValue
                Set psSeedValue of hoList to sValue
            End
        End
        Send Popup of hoPanel
        Get pbCanceled of hoList to bCanceled
        Get SelectedRowIds of hoList to riSelected
        Set peUpdateMode of hoList to eOldMode
        If (bSeed) Begin
            Set piUpdateColumn of hoList to iOldColumn
        End
        If (bCanceled or (SizeOfArray(riSelected) = 0)) Begin
            Procedure_Return
        End
        Get Main_File of (Server(hoList)) to iFile
        Get Which_Data_Set of hoDD iFile to hoTarget
        If (hoTarget = 0) Begin
            Procedure_Return
        End
        Get FindByRowIdEx of hoDD iFile riSelected[0] to bFound
        If (not(bFound)) Begin
            Error DFERR_CANT_REFIND_RECORD
        End
    End_Procedure

    // F4 and the prompt button (OnPrompt sends Prompt), and the toolbar's Prompt.
    Procedure Prompt
        If (FTNativePromptPanel(Self) <> 0) Begin
            Send RelaySend of (FTClickRelay()) Self (RefProc(FTOpenNativePrompt))
            Procedure_Return
        End
        Forward Send Prompt
    End_Procedure

End_Class