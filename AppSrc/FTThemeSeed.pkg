//****************************************************************************
// $Module type: Package
// $Module name: FTThemeSeed
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-13
//
// Description : SeedFTTheme: giFTThemeMode from the saved choice, once, as soon as the application object
//               exists - before any FT panel or dialog is built, since those colour themselves as they are.
//
//               A cFTApplication sends it itself, at the end of its construction: a program whose application
//               object is a cFTApplication never Uses or sends it. A program whose application object is of
//               a class of its own (DFRefactor's cRefactorApplication) Uses this package after that object and
//               sends SeedFTTheme there.
//
//               Not part of FTThemeColors.pkg: the colour functions are compiled near the top of a program,
//               before its application class is, and this reads the registry through the application object.
//
//               cFTThemeHost_mixin.pkg seeds too, on the first FlexTron host built - a backstop for a program
//               that does neither. Both do nothing once the theme is known (CI_FTThemeUnset), and both theme
//               the FT objects built before it was, which waited for it (FTThemeLateObjects).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use FTConstants.h.pkg   // CI_FTTheme*, giFTThemeMode, CS_FTThemeSection / CS_FTTheme
Use FTThemeColors.pkg   // FTThemeLateObjects

Procedure SeedFTTheme Global
    Integer iMode

    If (giFTThemeMode <> CI_FTThemeUnset) ;
        Procedure_Return
    If (ghoApplication = 0) ;
        Procedure_Return

    Get ReadInteger of ghoApplication CS_FTThemeSection CS_FTTheme CI_FTThemeDark to iMode
    // A value written by a future version - or a hand-edited registry - must not leave the global on
    // a meaningless number, so anything unrecognised falls back to dark.
    If (iMode < CI_FTThemeDark or iMode > CI_FTThemeSystem) ;
        Move CI_FTThemeDark to iMode
    Move iMode to giFTThemeMode
    // And every FT object built before now - a dialog Used above the application object - takes it.
    Send FTThemeLateObjects
End_Procedure
